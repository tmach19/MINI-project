PORT=4000
# PostgreSQL Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chinese_study"
# Hoặc Supabase Session Pooler:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

JWT_SECRET="change-this-to-a-strong-secret-in-production"
CORS_ORIGIN="http://localhost:5173"

# Khi chưa nạp DB hoặc chưa chạy Postgres local, bật true để dùng dữ liệu dự phòng từ ../data.js
ALLOW_MEMORY_FALLBACK=true

# Trợ lý AI & Từ điển Trung-Việt (Google AI Studio / OpenAI-compatible)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# AI_BASE_URL=""
