PORT=4001
CORS_ORIGIN=http://localhost:5173

# Dùng chung PostgreSQL / Supabase với backend Tiếng Trung (chạy 1 lần db-migration/ cho cả 2 service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chinese-study
DB_SSL=auto
ALLOW_MEMORY_FALLBACK=true

# Đặt giống JWT_SECRET của backend Tiếng Trung để SSO tự động giữa / và /en
JWT_SECRET=replace-with-same-secret-as-backend
JWT_EXPIRES_IN=7d

# Supabase Storage public base URL cho ảnh WebP + audio MP3 UK/US (Word Atlas)
EN_MEDIA_BASE_URL=https://jxzxxmybmlwnfjalcykv.supabase.co/storage/v1/object/public/tmach/en-atlas

# Chỉ cần khi chạy scripts/upload-en-media-supabase.mjs để upload thêm cấp độ A2/B1/B2
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_EN_MEDIA_BUCKET=tmach
# SUPABASE_EN_MEDIA_PREFIX=en-atlas

# Gemini API cho Từ điển AI, Gia sư AI & Chấm điểm ngữ nghĩa tự động
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
